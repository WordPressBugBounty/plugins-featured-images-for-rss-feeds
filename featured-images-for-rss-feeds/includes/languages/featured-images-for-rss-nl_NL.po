msgstr "Afbeelding gecentreerd boven tekst"

#: featured_images_in_rss.php:226
msgid "Image Left Text Wraps"
msgstr "Afbeelding links, tekst loopt door"

#: featured_images_in_rss.php:227
msgid "Image Right Text Wraps"
msgstr "Afbeelding rechts, tekst loopt door"

